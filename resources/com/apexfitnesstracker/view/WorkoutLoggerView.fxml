<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" xmlns="http://javafx.com/javafx/17.0.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ApexFitnessTracker.controller.WorkoutLoggerController">
   <bottom>
      <FlowPane alignment="BOTTOM_CENTER" hgap="55.0" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="homeBtn" mnemonicParsing="false" onAction="#onHomeBtn" text="Home">
               <FlowPane.margin>
                  <Insets />
               </FlowPane.margin>
            </Button>
            <Button fx:id="libraryBtn" mnemonicParsing="false" onAction="#onLibraryBtn" text="Library">
               <FlowPane.margin>
                  <Insets />
               </FlowPane.margin>
            </Button>
            <Button fx:id="graphBtn" mnemonicParsing="false" onAction="#onGraphBtn" text="Graph">
               <FlowPane.margin>
                  <Insets />
               </FlowPane.margin>
            </Button>
            <Button fx:id="historyBtn" mnemonicParsing="false" onAction="#onHistoryBtn" text="History">
               <FlowPane.margin>
                  <Insets />
               </FlowPane.margin>
            </Button>
            <Button fx:id="bodyBtn" mnemonicParsing="false" onAction="#onBodyBtn" text="Body">
               <FlowPane.margin>
                  <Insets />
               </FlowPane.margin>
            </Button>
         </children>
      </FlowPane>
   </bottom>
   <top>
      <HBox alignment="CENTER_LEFT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" spacing="10.0" BorderPane.alignment="CENTER_LEFT">
         <children>
            <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" text="Workout Logger" HBox.hgrow="ALWAYS">
               <font>
                  <Font size="52.0" />
               </font>
               <HBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </HBox.margin>
            </Label>
            <Region maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" HBox.hgrow="ALWAYS" />
            <Button fx:id="profileBtn" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="50.0" mnemonicParsing="false" onAction="#onProfileBtn" text="Profile" HBox.hgrow="NEVER">
               <HBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
   </top>
   <center>
      <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="200.0" minWidth="200.0" style="-fx-border-color: BLACK;" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER" VBox.vgrow="NEVER">
               <children>
                  <Label alignment="CENTER" text="Add Quick Workout" HBox.hgrow="ALWAYS">
                     <font>
                        <Font size="30.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <HBox alignment="CENTER">
               <children>
                  <Label text="Workout Name: ">
                     <font>
                        <Font size="20.0" />
                     </font>
                  </Label>
                  <TextField fx:id="nameFld" promptText="e.g Upper Body" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            <Label text="Date and Time:">
               <font>
                  <Font size="20.0" />
               </font>
            </Label>
            <HBox alignment="CENTER_LEFT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="10.0" VBox.vgrow="NEVER">
               <children>
                  <Label text="Date:" />
                  <TextField fx:id="dateFld" onAction="#onDate" promptText="e.g 11/17/25" />
                  <VBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label text="Start Time:" HBox.hgrow="ALWAYS" />
                              <TextField fx:id="startTimeFld" onAction="#onTime" promptText="e.g 10:05am" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label text="End Time:" HBox.hgrow="ALWAYS" />
                              <TextField fx:id="endTimeFld" onAction="#onTime" promptText="e.g 10:05am" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </HBox>
            <Label text="Exercises:">
               <font>
                  <Font size="20.0" />
               </font>
            </Label>
            <HBox alignment="CENTER_LEFT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="20.0">
               <children>
                  <Label text="Exercise Name:" />
                  <ComboBox fx:id="chooseExercise" editable="false" onAction="#onChooseExercise" promptText="None chosen" />
                  <Button fx:id="addSetBtn" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="50.0" mnemonicParsing="false" onAction="#onAddSet" prefHeight="25.0" prefWidth="93.0" text="Add Set" />
                  <Button fx:id="removeSetBtn" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="50.0" mnemonicParsing="false" onAction="#onRemoveSet" prefHeight="25.0" prefWidth="93.0" text="Remove Set" />
               </children>
            </HBox>
            <TableView fx:id="exerciseTable" editable="true" minHeight="0.0" minWidth="0.0" prefHeight="52.0" VBox.vgrow="NEVER">
              <columns>
                <TableColumn fx:id="weightCol" editable="true" prefWidth="75.0" text="Weight" />
                <TableColumn fx:id="repsCol" editable="true" prefWidth="75.0" text="Reps" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
               <VBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </VBox.margin>
            </TableView>
            <Separator maxWidth="1.7976931348623157E308">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding></Separator>
            <HBox alignment="CENTER" VBox.vgrow="NEVER">
               <children>
                  <Button fx:id="addWorkoutBtn" mnemonicParsing="false" onAction="#onAddWorkout" text="Add Workout">
                     <font>
                        <Font size="18.0" />
                     </font>
                     <HBox.margin>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </HBox.margin>
                  </Button>
               </children>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </HBox>
         </children>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding>
      </VBox>
   </center>
   <left>
      <Accordion maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" BorderPane.alignment="CENTER">
        <panes>
          <TitledPane animated="false" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" text="untitled 1">
            <content>
              <AnchorPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" />
            </content>
          </TitledPane>
          <TitledPane animated="false" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" text="untitled 2">
            <content>
              <AnchorPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" />
            </content>
          </TitledPane>
          <TitledPane animated="false" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" text="untitled 3">
            <content>
              <AnchorPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" />
            </content>
          </TitledPane>
        </panes>
      </Accordion>
   </left>
   <right>
      <ToolBar maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" BorderPane.alignment="TOP_LEFT">
        <items>
          <Button mnemonicParsing="false" text="Button" />
        </items>
      </ToolBar>
   </right>
</BorderPane>
