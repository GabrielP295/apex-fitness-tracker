<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" xmlns="http://javafx.com/javafx/17.0.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ApexFitnessTracker.controller.LogInController">
   <top>
      <HBox alignment="CENTER_LEFT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" spacing="10.0" BorderPane.alignment="CENTER_LEFT">
         <children>
            <Label alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" text="Log In" wrapText="true" HBox.hgrow="ALWAYS">
               <font>
                  <Font size="52.0" />
               </font>
               <HBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </HBox.margin>
            </Label>
         </children>
      </HBox>
   </top>
   <center>
      <GridPane alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" BorderPane.alignment="CENTER">
        <columnConstraints>
          <ColumnConstraints hgrow="ALWAYS" maxWidth="1.7976931348623157E308" minWidth="180.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="70.0" vgrow="NEVER" />
            <RowConstraints minHeight="30.0" vgrow="NEVER" />
          <RowConstraints minHeight="30.0" vgrow="NEVER" />
          <RowConstraints minHeight="30.0" vgrow="NEVER" />
            <RowConstraints minHeight="30.0" vgrow="NEVER" />
        </rowConstraints>
         <children>
            <Label maxWidth="1.7976931348623157E308" text="Welcome back!">
               <font>
                  <Font size="28.0" />
               </font>
            </Label>
            <TextField fx:id="emailTxtFld" maxWidth="350.0" onAction="#onEmailTxtFld" GridPane.hgrow="NEVER" GridPane.rowIndex="2" GridPane.vgrow="NEVER" />
            <Label maxWidth="1.7976931348623157E308" text="Password:" GridPane.rowIndex="3" />
            <TextField fx:id="passwordTxtFld" maxWidth="350.0" onAction="#onPasswordTxtFld" GridPane.hgrow="NEVER" GridPane.rowIndex="4" GridPane.vgrow="NEVER" />
            <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" text="Email:" GridPane.rowIndex="1" />
         </children>
         <BorderPane.margin>
            <Insets bottom="5.0" left="25.0" right="25.0" top="5.0" />
         </BorderPane.margin>
      </GridPane>
   </center>
   <right>
      <Region minHeight="0.0" minWidth="0.0" BorderPane.alignment="CENTER" />
   </right>
   <bottom>
      <VBox alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="logInBtn" alignment="CENTER" mnemonicParsing="false" onAction="#onLogInBtn" text="Log In" />
            <FlowPane alignment="CENTER">
               <children>
                  <Label text="Don't have an account?" />
                  <Hyperlink fx:id="signUpLnk" onAction="#onSignUpLnk" text="Sign Up" />
               </children>
            </FlowPane>
         </children>
         <BorderPane.margin>
            <Insets bottom="10.0" />
         </BorderPane.margin>
      </VBox>
   </bottom>
</BorderPane>
